# 실제 값은 .env(커밋 안 됨) 또는 Kubernetes Secret에
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# 관리자 API(/api/v1/admin/cooking/**) 노출 여부. 인증 연동 전까지 로컬·dev만 true, prod는 비워 둠(기본 false)
COOKING_ADMIN_ENABLED=
# Menu 내부 API 주소 (CO-02). 줄을 지우거나 주석이면 기본값 http://localhost:8081 사용 (빈 값으로 두지 말 것)
# MENU_SERVICE_URL=http://localhost:8081
