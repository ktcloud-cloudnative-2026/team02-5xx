{
  "name": "@peak-order/web-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:ui": "node tests/ui-fixture.mjs",
    "test:checkout:ui": "node tests/checkout-preview.mjs",
    "test:customer:ui": "node tests/customer-http-preview.mjs",
    "test:account:ui": "node tests/account-dev-preview.mjs",
    "test:admin-orders:ui": "node tests/admin-orders-preview.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview:admin": "node scripts/admin-preview.mjs",
    "check:admin-boundary": "node scripts/check-admin-boundary.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.0",
    "vite": "8.3.8"
  }
}
